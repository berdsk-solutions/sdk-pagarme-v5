## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leasePublic/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you have tasks that create the TestResults folder
#TestResults/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent.log

# xUnit
BenchmarkDotNet.Artifacts/

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# Microsoft Azure Build Output
csx/
*.build.csdef

# CodeAnalysis report
CodeAnalysisLog.xml
*.lastcodeanalysistime

# Python Tools for Visual Studio (PTVS)
__pycache__/
*.pyc

# Stress Testing Results
*.loadtest

# SQL Server files
*.7z
*.bak
*.mdf
*.ldf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.bak

# Fabric
Visual Studio Tools for Docker/

# Others
/TestResults/
/LocalHistory/
/*.sln.lock
.vshost.exe
.vshost.exe.config
.vshost.exe.manifest
/_Changelog*
/AutoTest.Net/
/QuickGraph.Tests/bin/
/QuickGraph.Tests/obj/
/QuickGraph.MSAGL.Tests/bin/
/QuickGraph.MSAGL.Tests/obj/

# Rider
.idea/
.junie/
*.sln.iml

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet Look-thru mode
# !**/[Pp]ackages/

# Microsoft Azure Web App publish settings. Comment the next line if you want to
# publish your settings, but be aware that they might contain sensitive information.
publishxml

# Synthetic events logger reports
*.vsevents

# Redis cache package usage statistics
obj/project.assets.json
obj/project.packagespec.json
obj/project.assets.json
obj/project.nuget.cache

# Others
[Bb]in
[Oo]bj
*.[Ll]og

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
